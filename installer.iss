[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{A00386DD-66AB-4491-A4B3-B11041B43ACF}
AppName=ALMAutomation
AppVersion=1.0
;AppVerName=ALMAutomation 1.0
AppPublisher=Anthony Lew
AppPublisherURL=Anthony.Lew@au.bosch.com
AppSupportURL=Anthony.Lew@au.bosch.com
AppUpdatesURL=Anthony.Lew@au.bosch.com
DefaultDirName=./ALMAutomation
DefaultGroupName=ALMAutomation
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users.)
PrivilegesRequired=lowest
OutputBaseFilename=ALMAutomationInstaller
SetupIconFile=icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
UsePreviousAppDir=no  

[Code]
var
  APIKeyPage: TInputQueryWizardPage;

procedure InitializeWizard();
begin
  // Create a new input query page
  APIKeyPage := CreateInputQueryPage(wpSelectDir, 'API Key', 'Please enter your API key:', 'Get the API Key from here: https://inside-docupedia.bosch.com/confluence2/genaiplatform/llm-farm-372737736.html');
  APIKeyPage.Add('API Key:', False);
end;


function NextButtonClick(CurPageID: Integer): Boolean;
var
  ConfigFile: string;
  ConfigContent: string;
  APIKey: string;
begin
  // Check if we are on the API Key page
  if CurPageID = APIKeyPage.ID then
  begin
    // Get the API key from the input field
    APIKey := APIKeyPage.Values[0];
    if APIKey = '' then
    begin
      MsgBox('API key is required!', mbError, MB_OK);
      Result := False; // Cancel installation
      Exit;
    end;

    // Ensure the secrets directory exists
    if not ForceDirectories(ExpandConstant('{app}\secrets')) then
    begin
       MsgBox('Creation of ' + ExpandConstant('{app}\secrets') + ' folder failed!', mbError, MB_OK); 
       Result := False
       Exit;
    end;
    
    // Save the API key to the config file
    ConfigFile := ExpandConstant('{app}\secrets\.env');
    ConfigContent := Format('LLM_API_KEY=%s', [APIKey]);
    SaveStringToFile(ConfigFile, ConfigContent, false);
    SaveStringToFile(ConfigFile, #13#10+'PORT=3000', True);
    end;

    Result := True
end;


[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
// note: replace these with your source code install paths
Source: "C:\Users\LEA6CL\Documents\ALMAutomation\ALMAutomation.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\LEA6CL\Documents\ALMAutomation\README.txt"; DestDir: "{app}"; Flags: ignoreversion isreadme
Source: "C:\Users\LEA6CL\Documents\OpenSSL-1.1.1h_win32\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs deleteafterinstall

[Icons]
Name: "{group}\ALMAutomation"; Filename: "{app}\ALMAutomation.exe"
Name: "{autodesktop}\ALMAutomation"; Filename: "{app}\ALMAutomation.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\ALMAutomation.exe"; Description: "{cm:LaunchProgram,ALMAutomation}"; Flags: nowait postinstall skipifsilent


