{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS", // Change this to CommonJS
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*"]
}