{
  "name": "alm-automation",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "frontend": "bunx --bun vite frontend",
    "build-frontend": "bunx --bun vite build frontend",
    "backend": "bun run backend/src/server.ts 3001 false",
    "dev": "bun run build-frontend && bun run backend/src/server.ts",
    "compile": "bun run build-frontend && bun run compile-back",
    "compile-back": "bun build --compile --minify --sourcemap --target=bun-windows-x64 backend/src/server.ts --outfile ALMAutomation"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.11.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.1",
    "fast-xml-parser": "^5.2.5",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "tailwindcss": "^4.1.11",
    "undici": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/node-forge": "^1.3.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
